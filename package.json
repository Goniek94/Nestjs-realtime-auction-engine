{
  "name": "nestjs-realtime-auction-engine",
  "version": "0.1.0",
  "description": "Concurrency-safe realtime auction primitives for TypeScript and NestJS applications.",
  "license": "MIT",
  "author": "Mateusz Goszczycki",
  "private": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/esm/nestjs/index.d.ts",
        "default": "./dist/esm/nestjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/nestjs/index.d.ts",
        "default": "./dist/cjs/nestjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/cjs/nestjs/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.cjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "auction",
    "nestjs",
    "typescript",
    "socket.io",
    "realtime",
    "anti-sniping",
    "postgresql",
    "marketplace",
    "bidding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Goniek94/Nestjs-realtime-auction-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Goniek94/Nestjs-realtime-auction-engine/issues"
  },
  "homepage": "https://github.com/Goniek94/Nestjs-realtime-auction-engine#readme",
  "peerDependencies": {
    "@nestjs/common": ">=9"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/testing": "^11.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.3"
  }
}
